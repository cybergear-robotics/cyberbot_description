    <version>0.1.0</version>
    <description>CyberBot Description Package</description>
    <maintainer email="johannes.fischer@fischejo.de">Johannes Fischer</maintainer>
    <license>MIT</license>
    <buildtool_depend>ament_cmake</buildtool_depend>
    <exec_depend>joint_state_publisher</exec_depend>
